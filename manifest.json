{
  "manifest_version": 3,
  "name": "SightScribe - Live Captions & Screen Reader",
  "version": "1.1.0",
  "description": "Hear audio from songs and videos playing in any browser tab to generate real-time AI captions, or read the entire screen tab out loud.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabCapture",
    "activeTab",
    "storage",
    "offscreen",
    "sidePanel",
    "tts",
    "scripting"
  ],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://api.openai.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SightScribe - Live Captions & Screen Reader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "toggle_screen_reader": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Read browser tab out loud (Screen Reader)"
    },
    "stop_screen_reader": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Stop Screen Reader speech"
    }
  }
}
